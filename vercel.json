{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "SKIP_LOGO_DOWNLOAD=1 npm install",
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=6144",
    "SKIP_LOGO_DOWNLOAD": "1"
  },
  "crons": [
    {
      "path": "/api/cron/sync-matches",
      "schedule": "0 8 * * *"
    }
  ]
}
