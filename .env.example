# Supabase → Dashboard → Project Settings → API
# URL del proyecto (ejemplo BrawlForge):
NEXT_PUBLIC_SUPABASE_URL=https://bkxxykztewquhnimpjgc.supabase.co
# Clave pública: "anon" / "publishable" (empieza por eyJ... o sb_publishable_...)
# NO uses sb_secret_ ni service_role en el front.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# false en producción; true solo para probar /admin sin login
NEXT_PUBLIC_DEMO_ADMIN=false

# Solo en servidor local (npm run supabase:seed:catalog) — nunca NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=
