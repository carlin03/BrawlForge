<!DOCTYPE html>
<html>
  <head>
    <title>Supercell</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
      body {
        position: relative;
        background-color: black;
        color: white;
        margin: 0;
        padding: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        min-height: 100dvh;
        overflow: hidden;
      }

      .content {
        position: relative;
        z-index: 10;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        padding: 16px;
        width: 100%;
        max-width: 642px;
      }

      .logo {
        position: absolute;
        top: 60px;
        left: 50%;
        transform: translateX(-50%);
        width: 25%;
        aspect-ratio: 80 / 65;
        height: auto;
        max-width: 80px;

        @media screen and (max-height: 400px) {
          display: none;
        }

        img {
          width: 100%;
          height: 100%;
          object-fit: contain;
          object-position: center;
        }
      }

      .headline {
        img {
          width: 100%;
          height: auto;
        }
      }
    </style>
  </head>

  <body>
    <div class="logo">
      <img
        src="data:image/png;base64,"
      />
    </div>
    <div class="content">
      <div class="headline">
        <img
          src="data:image/png;base64,"
        />
      </div>
    </div>
  </body>
</html>
